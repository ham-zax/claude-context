      "split": "tuning",
      "queryClass": "owner_discovery",
      "language": "javascript",
      "expected": {
        "ownerFile": "assets/cart.js",
        "ownerSymbol": "CartItems"
      },
      "workload": {
        "setup": [
          {
            "tool": "manage_index",
            "args": {
              "action": "status",
              "path": "$REPO_ROOT"
            }
