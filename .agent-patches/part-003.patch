+import test from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { loadRankingPolicyV3FromTrustedStore } from './ranking-policy-store.js';
+
+const sha = (character: string): string => character.repeat(64);
+function artifact(): object {
+    return {
+        schemaVersion: 'ranking_policy_v3', policyId: 'search_ranking_policy_v3', featureSchema: 'search_features_v1',
+        createdFromCommit: 'a'.repeat(40), trainingManifestSha256: sha('b'), trainingCodeSha256: sha('c'),
+        trainingContractSha256: sha('d'), qualificationTargetSha256: sha('e'), residualModelSha256: sha('f'),
+        normalization: { schemaVersion: 'ranking_normalization_contract_v1', featureOrder: ['x'], means: [0], scales: [1], missingValuePolicy: 'indicator_zero_fill' },
+        weights: [0], residualBounds: { maximumResidual: 0.1 }, neuralReorderPolicy: { mode: 'disabled' },
+        applicability: { mode: 'disabled', baselinePolicyIdentity: 'search_candidate_final_score_v2', featureContractSha256: sha('1'), runtimeScoringContractId: 'score-v3', retrievalContractId: 'retrieval-v3', supportedProviderKeys: [] },
+    };
+}
+
+test('loader_hashes_the_opened_descriptor_bytes', async () => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'satori-policy-store-'));
+    try {
+        const file = path.join(root, 'policy.json');
+        const bytes = Buffer.from(`${JSON.stringify(artifact(), null, 4)}\n`, 'utf8');
+        fs.writeFileSync(file, bytes, { mode: 0o600 });
+        const rawDigest = crypto.createHash('sha256').update(bytes).digest('hex');
+        const loaded = await loadRankingPolicyV3FromTrustedStore({ rootDir: root, artifactPath: file, expectedArtifactSha256: rawDigest });
+        assert.equal(loaded.artifactSha256, rawDigest);
+        assert.deepEqual(loaded.artifactBytes, bytes);
+        const differentSerialization = Buffer.from(JSON.stringify(artifact()), 'utf8');
+        const wrongDigest = crypto.createHash('sha256').update(differentSerialization).digest('hex');
+        await assert.rejects(
+            () => loadRankingPolicyV3FromTrustedStore({ rootDir: root, artifactPath: file, expectedArtifactSha256: wrongDigest }),
+            /opened.*bytes.*digest/i,
+        );
+    } finally {
+        fs.rmSync(root, { recursive: true, force: true });
+    }
+});
diff --git a/packages/mcp/src/core/ranking-policy-store.ts b/packages/mcp/src/core/ranking-policy-store.ts
new file mode 100644
index 0000000..a6ef3f5
--- /dev/null
+++ b/packages/mcp/src/core/ranking-policy-store.ts
@@ -0,0 +1,48 @@
+import crypto from 'node:crypto';
+import path from 'node:path';
+import {
+    openTrustedRegularFileInsideRootV1,
+    readFileHandleExactly,
+    verifyTrustedPathHierarchyV1,
+} from '@zokizuan/satori-core';
+import {
+    parseRankingPolicyV3Artifact,
+    type ParseArtifactOptions,
+    type RankingPolicyV3Artifact,
+} from './ranking-policy-artifact.js';
+
+const SHA256 = /^[a-f0-9]{64}$/;
+
+export interface LoadedRankingPolicyV3 {
+    artifactPath: string;
+    artifactSha256: string;
+    artifactBytes: Buffer;
+    artifact: RankingPolicyV3Artifact;
+}
+
+export async function loadRankingPolicyV3FromTrustedStore(input: {
+    rootDir: string;
+    artifactPath: string;
+    expectedArtifactSha256: string;
+    parseOptions?: ParseArtifactOptions;
+}): Promise<LoadedRankingPolicyV3> {
+    if (!SHA256.test(input.expectedArtifactSha256)) {
+        throw new Error('expectedArtifactSha256 must be a lowercase SHA-256 digest.');
+    }
+    const absolutePath = path.isAbsolute(input.artifactPath)
+        ? path.normalize(input.artifactPath)
+        : path.resolve(input.rootDir, input.artifactPath);
+    const opened = await openTrustedRegularFileInsideRootV1(absolutePath, input.rootDir);
+    try {
+        const bytes = await readFileHandleExactly(opened.handle, opened.observedStat.size);
+        const artifactSha256 = crypto.createHash('sha256').update(bytes).digest('hex');
+        if (artifactSha256 !== input.expectedArtifactSha256) {
+            throw new Error('Opened ranking-policy descriptor bytes do not match the expected artifact digest.');
+        }
+        const artifact = parseRankingPolicyV3Artifact(JSON.parse(bytes.toString('utf8')), input.parseOptions);
+        await verifyTrustedPathHierarchyV1(opened);
+        return { artifactPath: absolutePath, artifactSha256, artifactBytes: bytes, artifact };
+    } finally {
+        await opened.handle.close().catch(() => undefined);
+    }
+}
