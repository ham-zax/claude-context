+import assert from 'node:assert/strict';
+import * as fsp from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import test from 'node:test';
+import {
+    appendRankingShadowRecordV1,
+    parseRankingShadowRecordV1,
+    serializeRankingShadowRecordV1,
+} from './ranking-shadow.js';
+
+const sha = (character: string): string => character.repeat(64);
+const record = {
+    schemaVersion: 'ranking_shadow_record_v1' as const,
+    querySha256: sha('a'),
+    candidateSetSha256: sha('b'),
+    baselineOrderSha256: sha('c'),
+    deterministicOrderSha256: sha('d'),
+    providerOrderSha256: null,
+    artifactSha256: sha('e'),
+    qualificationScopeKey: sha('f'),
+    outcome: 'deterministic_applied' as const,
+};
+
+test('shadow_sink_is_hashed_only_and_rejects_raw_text_fields', async () => {
+    const root = await fsp.mkdtemp(path.join(os.tmpdir(), 'satori-shadow-'));
+    const filePath = path.join(root, 'shadow.jsonl');
+    const secretQuery = 'secret query text must never be written';
+    const secretSource = 'secret source body must never be written';
+    try {
+        assert.deepEqual(parseRankingShadowRecordV1(record), record);
+        assert.throws(() => parseRankingShadowRecordV1({
+            ...record,
+            queryText: secretQuery,
+        }), /exact hashed-only keys/i);
+        assert.throws(() => parseRankingShadowRecordV1({
+            ...record,
+            sourceText: secretSource,
+        }), /exact hashed-only keys/i);
+        await appendRankingShadowRecordV1(filePath, record);
+        const stored = await fsp.readFile(filePath, 'utf8');
+        assert.equal(stored, serializeRankingShadowRecordV1(record));
+        assert.equal(stored.includes(secretQuery), false);
+        assert.equal(stored.includes(secretSource), false);
+    } finally {
+        await fsp.rm(root, { recursive: true, force: true });
+    }
+});
diff --git a/packages/mcp/src/core/ranking-shadow.ts b/packages/mcp/src/core/ranking-shadow.ts
new file mode 100644
index 0000000..9dbd83c
--- /dev/null
+++ b/packages/mcp/src/core/ranking-shadow.ts
@@ -0,0 +1,108 @@
+import * as fsp from 'node:fs/promises';
+import path from 'node:path';
+
+export type RankingShadowOutcomeV1 =
+    | 'baseline_only'
+    | 'deterministic_applied'
+    | 'provider_applied'
+    | 'provider_skipped'
+    | 'provider_fallback';
+
+export interface RankingShadowRecordV1 {
+    schemaVersion: 'ranking_shadow_record_v1';
+    querySha256: string;
+    candidateSetSha256: string;
+    baselineOrderSha256: string;
+    deterministicOrderSha256: string;
+    providerOrderSha256: string | null;
+    artifactSha256: string | null;
+    qualificationScopeKey: string | null;
+    outcome: RankingShadowOutcomeV1;
+}
+
+const SHA256 = /^[a-f0-9]{64}$/;
+const KEYS = [
+    'artifactSha256',
+    'baselineOrderSha256',
+    'candidateSetSha256',
+    'deterministicOrderSha256',
+    'outcome',
+    'providerOrderSha256',
+    'qualificationScopeKey',
+    'querySha256',
+    'schemaVersion',
+] as const;
+
+function asRecord(value: unknown): Record<string, unknown> {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) {
+        throw new Error('Ranking shadow record must be an object.');
+    }
+    return value as Record<string, unknown>;
+}
+
+function exactKeys(input: Record<string, unknown>): void {
+    const actual = Object.keys(input).sort();
+    const expected = [...KEYS].sort();
+    if (actual.length !== expected.length || actual.some((key, index) => key !== expected[index])) {
+        throw new Error('Ranking shadow record must contain exact hashed-only keys.');
+    }
+}
+
+function digest(value: unknown, label: string, nullable = false): string | null {
+    if (nullable && value === null) return null;
+    if (typeof value !== 'string' || !SHA256.test(value)) {
+        throw new Error(`${label} must be a lowercase SHA-256 digest${nullable ? ' or null' : ''}.`);
+    }
+    return value;
+}
+
+function outcome(value: unknown): RankingShadowOutcomeV1 {
+    if (
+        value !== 'baseline_only'
+        && value !== 'deterministic_applied'
+        && value !== 'provider_applied'
+        && value !== 'provider_skipped'
+        && value !== 'provider_fallback'
+    ) {
+        throw new Error('Ranking shadow outcome is invalid.');
+    }
+    return value;
+}
+
+export function parseRankingShadowRecordV1(value: unknown): RankingShadowRecordV1 {
+    const input = asRecord(value);
+    exactKeys(input);
+    if (input.schemaVersion !== 'ranking_shadow_record_v1') {
+        throw new Error('Ranking shadow schema mismatch.');
+    }
+    return {
+        schemaVersion: 'ranking_shadow_record_v1',
+        querySha256: digest(input.querySha256, 'querySha256')!,
+        candidateSetSha256: digest(input.candidateSetSha256, 'candidateSetSha256')!,
+        baselineOrderSha256: digest(input.baselineOrderSha256, 'baselineOrderSha256')!,
+        deterministicOrderSha256: digest(input.deterministicOrderSha256, 'deterministicOrderSha256')!,
+        providerOrderSha256: digest(input.providerOrderSha256, 'providerOrderSha256', true),
+        artifactSha256: digest(input.artifactSha256, 'artifactSha256', true),
+        qualificationScopeKey: digest(input.qualificationScopeKey, 'qualificationScopeKey', true),
+        outcome: outcome(input.outcome),
+    };
+}
+
+export function serializeRankingShadowRecordV1(value: unknown): string {
+    return `${JSON.stringify(parseRankingShadowRecordV1(value))}\n`;
+}
+
+export async function appendRankingShadowRecordV1(
+    filePath: string,
+    value: unknown,
+): Promise<void> {
+    const serialized = serializeRankingShadowRecordV1(value);
+    await fsp.mkdir(path.dirname(path.resolve(filePath)), { recursive: true, mode: 0o700 });
+    const handle = await fsp.open(filePath, 'a', 0o600);
+    try {
+        await handle.writeFile(serialized, 'utf8');
+        await handle.sync();
+    } finally {
+        await handle.close();
+    }
+}
