ct applicability.');
+    }
+    return {
+        mode: 'provider_derived', policyIdentity: LEARNED_RANKING_POLICY_IDENTITY, artifactSha256,
+        rerankerIdentity: configured.rerankerIdentity,
+        rerankerProjectionIdentity: configured.rerankerProjectionIdentity,
+        configuredReranker: configured, artifact,
+    };
+}
