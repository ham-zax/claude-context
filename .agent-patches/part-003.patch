diff --git a/packages/mcp/src/core/ranking-policy-v3.ts b/packages/mcp/src/core/ranking-policy-v3.ts
new file mode 100644
index 0000000..4ce22a9
--- /dev/null
+++ b/packages/mcp/src/core/ranking-policy-v3.ts
@@ -0,0 +1,38 @@
+export interface RankedCandidateV3 {
+    candidateId: string;
+    deterministicV3Score: number;
+    postPolicyRank: number;
+}
+
+export interface DeterministicV3ScoreInput {
+    preRerankBaselineScore: number;
+    normalizedFeatures: readonly number[];
+    weights: readonly number[];
+    maximumResidual: number;
+}
+
+export interface DeterministicV3ScoreResult {
+    residual: number;
+    deterministicV3Score: number;
+}
+
+function finite(value: number, label: string): number {
+    if (!Number.isFinite(value)) throw new Error(`${label} must be finite.`);
+    return value;
+}
+
+export function scoreDeterministicV3(input: DeterministicV3ScoreInput): DeterministicV3ScoreResult {
+    finite(input.preRerankBaselineScore, 'preRerankBaselineScore');
+    finite(input.maximumResidual, 'maximumResidual');
+    if (input.maximumResidual < 0) throw new Error('maximumResidual must be non-negative.');
+    if (input.normalizedFeatures.length !== input.weights.length) throw new Error('Feature and weight lengths must match.');
+    let rawResidual = 0;
+    for (let index = 0; index < input.weights.length; index += 1) {
+        rawResidual += finite(input.normalizedFeatures[index], `normalizedFeatures[${index}]`)
+            * finite(input.weights[index], `weights[${index}]`);
+    }
+    const residual = Math.max(-input.maximumResidual, Math.min(input.maximumResidual, rawResidual));
+    const deterministicV3Score = input.preRerankBaselineScore + residual;
+    finite(deterministicV3Score, 'deterministicV3Score');
+    return { residual, deterministicV3Score };
+}
