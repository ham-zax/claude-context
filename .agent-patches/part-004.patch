@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+    buildSearchRankedSetBinding,
+    verifySearchRankedSetBinding,
+    type SearchRankedSetBindingInput,
+} from './search-result-set-identity.js';
+
+function input(): SearchRankedSetBindingInput {
+    return {
+        queryPolicyDigest: 'a'.repeat(64),
+        rankingPolicyIdentity: 'search_ranking_policy_v3',
+        rankingPolicyArtifactSha256: 'b'.repeat(64),
+        disclosurePolicyVersion: 'search_disclosure_v1',
+        publicationIdentity: {
+            collectionName: 'repo-generation',
+            marker: { runId: 'run-1' },
+            policyDocumentDigest: 'c'.repeat(64),
+            navigation: { status: 'not_bound' },
+        },
+        preparedObservation: 'prepared-1',
+        sourceObservation: null,
+        rerankerIdentity: { kind: 'disabled', identity: 'reranker_disabled_v1' },
+        rerankerProjectionIdentity: 'not_applicable',
+        orderedResults: [{
+            target: { file: 'src/owner.ts', span: { startLine: 1, endLine: 3 } },
+            displayLabel: 'src/owner.ts',
+            language: 'typescript',
+            score: 1,
+            quality: { owner: 'high', semantic: 'high' },
+            preview: 'export const owner = true;',
+            navigation: { graph: 'missing_symbol' },
+        }],
+        recommendedActions: [null],
+    };
+}
+
+test('continuation_identity_binds_artifact_and_disabled_reranker_identity', () => {
+    const original = input();
+    const binding = buildSearchRankedSetBinding(original);
+    assert.equal(binding.rankingPolicyArtifactSha256, 'b'.repeat(64));
+    assert.equal(verifySearchRankedSetBinding(binding, original), true);
+    assert.equal(verifySearchRankedSetBinding(binding, {
+        ...original,
+        rankingPolicyArtifactSha256: 'd'.repeat(64),
+    }), false);
+    assert.equal(verifySearchRankedSetBinding(binding, {
+        ...original,
+        rerankerIdentity: { kind: 'provider', provider: 'p', model: 'm', profile: 'q' },
+    }), false);
+    assert.throws(() => buildSearchRankedSetBinding({
+        ...original,
+        rankingPolicyArtifactSha256: 'not-a-digest',
+    }), /artifact/i);
+});
