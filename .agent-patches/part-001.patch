oviderKey,
+        rank: result.rank,
+        rawScore: result.rawScore,
+        withinQueryPercentile: rounded((response.results.length - 1 - index) / denominator),
+        candidateToTopMargin: rounded(topScore - result.rawScore),
+        topToSecondMargin: rounded(topScore - secondScore),
+    }));
+}
