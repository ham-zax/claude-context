+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    parseRankingPolicyQualificationRegistryV1,
+    qualificationScopeKeyV1,
+} from './ranking-policy-qualification.js';
+import { selectActivationQualifiedEntryV1 } from './ranking-policy-qualification-store.js';
+
+const sha = (character: string): string => character.repeat(64);
+const base = {
+    artifactSha256: sha('a'), serviceClass: 'online' as const, qualificationTargetSha256: sha('b'),
+    selectedArtifactMode: 'disabled' as const, qualifiedRerankers: [], offlineQualificationReceiptSha256: sha('c'),
+};
+const scope = qualificationScopeKeyV1(base);
+function registry(status: 'pending_heldout' | 'activation_qualified' | 'revoked') {
+    const common = { ...base, qualificationScopeKey: scope };
+    const entry = status === 'pending_heldout' ? { ...common, status }
+        : status === 'activation_qualified' ? { ...common, status, heldoutAcceptanceReceiptSha256: sha('d') }
+            : { ...common, status, terminalEvidence: { reason: 'heldout_rejected', heldoutRejectionReceiptSha256: sha('e') } };
+    return parseRankingPolicyQualificationRegistryV1({ schemaVersion: 'ranking_policy_qualification_registry_v1', entries: [entry] });
+}
+
+test('only_activation_qualified_exact_scope_is_selectable', () => {
+    const key = { artifactSha256: base.artifactSha256, serviceClass: base.serviceClass, qualificationScopeKey: scope };
+    assert.equal(selectActivationQualifiedEntryV1({ registry: registry('pending_heldout'), ...key }), null);
+    assert.equal(selectActivationQualifiedEntryV1({ registry: registry('revoked'), ...key }), null);
+    assert.equal(selectActivationQualifiedEntryV1({ registry: registry('activation_qualified'), ...key })?.status, 'activation_qualified');
+    assert.equal(selectActivationQualifiedEntryV1({ registry: registry('activation_qualified'), ...key, qualificationScopeKey: sha('f') }), null);
+});
