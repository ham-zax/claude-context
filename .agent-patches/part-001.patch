+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { applyProviderSlotPermutation } from './provider-slot-permutation.js';
+
+test('provider_permutation_is_final_complete_and_rank_contiguous', () => {
+    const deterministicOrder = [
+        { candidateId:'a', deterministicV3Score:100, postPolicyRank:1 },
+        { candidateId:'b', deterministicV3Score:1, postPolicyRank:2 },
+        { candidateId:'c', deterministicV3Score:50, postPolicyRank:3 },
+    ];
+    const result = applyProviderSlotPermutation({ deterministicOrder, baselineAdmissionIds:['a','b','c'], providerOrder:['b','c','a'] });
+    assert.deepEqual(result, [
+        { candidateId:'b', deterministicV3Score:1, postPolicyRank:1 },
+        { candidateId:'c', deterministicV3Score:50, postPolicyRank:2 },
+        { candidateId:'a', deterministicV3Score:100, postPolicyRank:3 },
+    ]);
+    assert.deepEqual(result.map((item) => item.candidateId), ['b','c','a'], 'a later score sort must not undo provider order');
+    assert.throws(() => applyProviderSlotPermutation({ deterministicOrder, baselineAdmissionIds:['a','b','c'], providerOrder:['b','a'] }), /complete|omission/i);
+    assert.throws(() => applyProviderSlotPermutation({ deterministicOrder, baselineAdmissionIds:['a','b','c'], providerOrder:['b','b','a'] }), /duplicate/i);
+    assert.throws(() => applyProviderSlotPermutation({ deterministicOrder:[{...deterministicOrder[0],postPolicyRank:2},...deterministicOrder.slice(1)], baselineAdmissionIds:['a','b','c'], providerOrder:['b','c','a'] }), /rank/i);
+});
diff --git a/packages/mcp/src/core/provider-slot-permutation.ts b/packages/mcp/src/core/provider-slot-permutation.ts
new file mode 100644
index 0000000..27e06b1
--- /dev/null
+++ b/packages/mcp/src/core/provider-slot-permutation.ts
@@ -0,0 +1,37 @@
+import type { RankedCandidateV3 } from './ranking-policy-v3.js';
+
+export interface ProviderSlotPermutationInput {
+    deterministicOrder: readonly RankedCandidateV3[];
+    baselineAdmissionIds: readonly string[];
+    providerOrder: readonly string[];
+}
+
+function uniqueIds(ids: readonly string[], label: string): void {
+    if (ids.some((id) => typeof id !== 'string' || id.length === 0)) throw new Error(`${label} contains an invalid candidate ID.`);
+    if (new Set(ids).size !== ids.length) throw new Error(`${label} contains duplicate candidate IDs.`);
+}
+
+export function applyProviderSlotPermutation(input: ProviderSlotPermutationInput): RankedCandidateV3[] {
+    uniqueIds(input.baselineAdmissionIds, 'baselineAdmissionIds');
+    uniqueIds(input.providerOrder, 'providerOrder');
+    if (input.deterministicOrder.length !== input.baselineAdmissionIds.length) throw new Error('Deterministic order must cover the complete admitted set.');
+    const admitted = new Set(input.baselineAdmissionIds);
+    const byId = new Map<string, RankedCandidateV3>();
+    input.deterministicOrder.forEach((candidate, index) => {
+        if (candidate.postPolicyRank !== index + 1 || !Number.isFinite(candidate.deterministicV3Score)) {
+            throw new Error('Deterministic order ranks must be one-based, contiguous, and finite.');
+        }
+        if (!admitted.has(candidate.candidateId)) throw new Error('Deterministic order contains a foreign candidate.');
+        if (byId.has(candidate.candidateId)) throw new Error('Deterministic order contains duplicate candidates.');
+        byId.set(candidate.candidateId, candidate);
+    });
+    if (input.providerOrder.length !== input.baselineAdmissionIds.length) throw new Error('Provider order must be a complete permutation; omission detected.');
+    for (const candidateId of input.providerOrder) {
+        if (!admitted.has(candidateId)) throw new Error('Provider order contains a foreign candidate.');
+    }
+    if (byId.size !== admitted.size) throw new Error('Deterministic order is incomplete.');
+    return input.providerOrder.map((candidateId, index) => ({
+        ...byId.get(candidateId)!,
+        postPolicyRank: index + 1,
+    }));
+}
