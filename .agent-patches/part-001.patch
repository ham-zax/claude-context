index 0000000..d4e996c
--- /dev/null
+++ b/packages/mcp/src/core/ranking-policy-qualification-store.ts
@@ -0,0 +1,48 @@
+import crypto from 'node:crypto';
+import path from 'node:path';
+import {
+    openTrustedRegularFileInsideRootV1,
+    readFileHandleExactly,
+    verifyTrustedPathHierarchyV1,
+} from '@zokizuan/satori-core';
+import {
+    parseRankingPolicyQualificationRegistryV1,
+    qualificationRegistryLogicalKeyV1,
+    type QualificationRegistryEntryV1,
+    type RankingPolicyQualificationRegistryV1,
+    type ServiceClass,
+} from './ranking-policy-qualification.js';
+
+export function selectActivationQualifiedEntryV1(input: {
+    registry: RankingPolicyQualificationRegistryV1;
+    artifactSha256: string;
+    serviceClass: ServiceClass;
+    qualificationScopeKey: string;
+}): Extract<QualificationRegistryEntryV1, { status: 'activation_qualified' }> | null {
+    const expected = `${input.artifactSha256}\0${input.serviceClass}\0${input.qualificationScopeKey}`;
+    const matches = input.registry.entries.filter((entry) => qualificationRegistryLogicalKeyV1(entry) === expected);
+    if (matches.length > 1) throw new Error('Qualification registry contains multiple exact-scope entries.');
+    const match = matches[0];
+    return match?.status === 'activation_qualified' ? match : null;
+}
+
+export async function loadQualificationRegistryFromTrustedStoreV1(input: {
+    rootDir: string;
+    registryPath: string;
+    expectedRegistryBytesSha256?: string;
+}): Promise<{ registry: RankingPolicyQualificationRegistryV1; registryBytesSha256: string }> {
+    const absolutePath = path.isAbsolute(input.registryPath) ? path.normalize(input.registryPath) : path.resolve(input.rootDir, input.registryPath);
+    const opened = await openTrustedRegularFileInsideRootV1(absolutePath, input.rootDir);
+    try {
+        const bytes = await readFileHandleExactly(opened.handle, opened.observedStat.size);
+        const registryBytesSha256 = crypto.createHash('sha256').update(bytes).digest('hex');
+        if (input.expectedRegistryBytesSha256 && registryBytesSha256 !== input.expectedRegistryBytesSha256) {
+            throw new Error('Opened qualification-registry bytes do not match the expected digest.');
+        }
+        const registry = parseRankingPolicyQualificationRegistryV1(JSON.parse(bytes.toString('utf8')));
+        await verifyTrustedPathHierarchyV1(opened);
+        return { registry, registryBytesSha256 };
+    } finally {
+        await opened.handle.close().catch(() => undefined);
+    }
+}
