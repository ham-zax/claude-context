+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { evaluateNeuralGate } from './neural-ranking-gate.js';
+import { buildNeuralRankingEvidence } from './neural-ranking-evidence.js';
+import type { ValidatedRerankResponseV1 } from './rerank-evidence.js';
+
+const sha = (c:string) => c.repeat(64);
+const target = { providerTarget:'fixed' as const, providerKey:'p', rerankerIdentity:'m', rerankerProjectionIdentity:'proj', providerConfigurationDigest:sha('a'), providerRequestContractSha256:sha('b') };
+const suppliedIdentity = { providerKey:'p', rerankerIdentity:'m', rerankerProjectionIdentity:'proj', providerConfigurationDigest:sha('a'), providerRequestContractSha256:sha('b') };
+const response: ValidatedRerankResponseV1 = { schemaVersion:'validated_rerank_response_v1', ...suppliedIdentity, canonicalRequestSha256:sha('c'), requestCandidateIds:['a','b','c'], results:[{candidateId:'b',rank:1,rawScore:10},{candidateId:'a',rank:2,rawScore:7},{candidateId:'c',rank:3,rawScore:1}] };
+const policy = { mode:'provider_derived' as const, providerKey:'p', minimumCandidates:3, minimumNormalizedTopToSecondMargin:0.2 };
+
+test('pure_gate_applies_only_for_exact_identity_complete_evidence_and_margin', () => {
+    const evidence = buildNeuralRankingEvidence(response);
+    assert.deepEqual(evaluateNeuralGate({ policy, target, suppliedIdentity, response, evidence, exactControlOwnsResult:false, baselineAdmissionIds:['a','b','c'] }), { decision:'apply' });
+    assert.deepEqual(evaluateNeuralGate({ policy, target, suppliedIdentity:{...suppliedIdentity, rerankerIdentity:'wrong'}, response, evidence, exactControlOwnsResult:false, baselineAdmissionIds:['a','b','c'] }), { decision:'fallback_deterministic', reason:'identity_mismatch' });
+    assert.deepEqual(evaluateNeuralGate({ policy:{...policy, minimumNormalizedTopToSecondMargin:0.5}, target, suppliedIdentity, response, evidence, exactControlOwnsResult:false, baselineAdmissionIds:['a','b','c'] }), { decision:'skip', reason:'insufficient_margin' });
+    assert.deepEqual(evaluateNeuralGate({ policy:{mode:'disabled'}, target, exactControlOwnsResult:false, baselineAdmissionIds:['a','b','c'] }), { decision:'skip', reason:'mode_disabled' });
+});
diff --git a/packages/mcp/src/core/neural-ranking-gate.ts b/packages/mcp/src/core/neural-ranking-gate.ts
new file mode 100644
index 0000000..4d0c0ee
--- /dev/null
+++ b/packages/mcp/src/core/neural-ranking-gate.ts
@@ -0,0 +1,79 @@
+import type { NeuralRankingEvidenceV1 } from './neural-ranking-evidence.js';
+import type { QualifiedRerankerV1 } from './ranking-policy-qualification.js';
+import type { ValidatedRerankResponseV1 } from './rerank-evidence.js';
+
+export interface NoProviderTargetV1 { providerTarget: 'none' }
+export interface FixedProviderTargetV1 extends QualifiedRerankerV1 { providerTarget: 'fixed' }
+export type QualificationTargetV1 = NoProviderTargetV1 | FixedProviderTargetV1;
+export type NeuralReorderPolicy =
+    | { mode: 'disabled' }
+    | { mode: 'provider_derived'; providerKey: string; minimumCandidates: number; minimumNormalizedTopToSecondMargin: number };
+export type NeuralGateDecision =
+    | { decision: 'apply' }
+    | { decision: 'skip'; reason: 'mode_disabled' | 'exact_control' | 'insufficient_margin' | 'insufficient_candidates' }
+    | { decision: 'fallback_deterministic'; reason: 'provider_mismatch' | 'invalid_response' | 'identity_mismatch' | 'non_finite_score' };
+
+export type NeuralGateInput =
+    | { policy: { mode: 'disabled' }; target: QualificationTargetV1; exactControlOwnsResult: boolean; baselineAdmissionIds: readonly string[] }
+    | {
+        policy: Extract<NeuralReorderPolicy, { mode: 'provider_derived' }>;
+        target: FixedProviderTargetV1;
+        suppliedIdentity: QualifiedRerankerV1;
+        response: ValidatedRerankResponseV1;
+        evidence: readonly NeuralRankingEvidenceV1[];
+        exactControlOwnsResult: boolean;
+        baselineAdmissionIds: readonly string[];
+    };
+
+const sameIdentity = (left: QualifiedRerankerV1, right: QualifiedRerankerV1): boolean =>
+    left.providerKey === right.providerKey
+    && left.rerankerIdentity === right.rerankerIdentity
+    && left.rerankerProjectionIdentity === right.rerankerProjectionIdentity
+    && left.providerConfigurationDigest === right.providerConfigurationDigest
+    && left.providerRequestContractSha256 === right.providerRequestContractSha256;
+
+export function evaluateNeuralGate(input: NeuralGateInput): NeuralGateDecision {
+    if (input.policy.mode === 'disabled') return { decision: 'skip', reason: 'mode_disabled' };
+    if (input.exactControlOwnsResult) return { decision: 'skip', reason: 'exact_control' };
+    if (input.policy.providerKey !== input.target.providerKey || input.response.providerKey !== input.target.providerKey) {
+        return { decision: 'fallback_deterministic', reason: 'provider_mismatch' };
+    }
+    if (!sameIdentity(input.target, input.suppliedIdentity) || !sameIdentity(input.target, input.response)) {
+        return { decision: 'fallback_deterministic', reason: 'identity_mismatch' };
+    }
+    const minimumCandidates = Math.max(3, input.policy.minimumCandidates);
+    if (input.baselineAdmissionIds.length < minimumCandidates) return { decision: 'skip', reason: 'insufficient_candidates' };
+    const admitted = new Set(input.baselineAdmissionIds);
+    if (admitted.size !== input.baselineAdmissionIds.length
+        || input.response.requestCandidateIds.length !== input.baselineAdmissionIds.length
+        || input.response.requestCandidateIds.some((candidateId, index) => candidateId !== input.baselineAdmissionIds[index])
+        || input.response.results.length !== input.baselineAdmissionIds.length
+        || input.evidence.length !== input.baselineAdmissionIds.length
+        || input.response.results.some((result, index) => result.rank !== index + 1 || !admitted.has(result.candidateId))
+        || new Set(input.response.results.map((result) => result.candidateId)).size !== admitted.size
+        || new Set(input.evidence.map((result) => result.candidateId)).size !== admitted.size) {
+        return { decision: 'fallback_deterministic', reason: 'invalid_response' };
+    }
+    if (input.response.results.some((result) => !Number.isFinite(result.rawScore))
+        || input.evidence.some((entry) => !Number.isFinite(entry.rawScore)
+            || !Number.isFinite(entry.withinQueryPercentile)
+            || !Number.isFinite(entry.candidateToTopMargin)
+            || !Number.isFinite(entry.topToSecondMargin))) {
+        return { decision: 'fallback_deterministic', reason: 'non_finite_score' };
+    }
+    for (let index = 1; index < input.response.results.length; index += 1) {
+        if (input.response.results[index - 1].rawScore < input.response.results[index].rawScore) {
+            return { decision: 'fallback_deterministic', reason: 'invalid_response' };
+        }
+    }
+    const top = input.response.results[0].rawScore;
+    const second = input.response.results[1].rawScore;
+    const bottom = input.response.results[input.response.results.length - 1].rawScore;
+    const range = top - bottom;
+    const normalizedMargin = range > 0 ? (top - second) / Math.max(Number.EPSILON, range) : 0;
+    if (!Number.isFinite(normalizedMargin)) return { decision: 'fallback_deterministic', reason: 'non_finite_score' };
+    if (normalizedMargin < input.policy.minimumNormalizedTopToSecondMargin) {
+        return { decision: 'skip', reason: 'insufficient_margin' };
+    }
+    return { decision: 'apply' };
+}
