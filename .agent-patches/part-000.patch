diff --git a/packages/core/src/sync/root-bound-fs.ranking-v3.test.ts b/packages/core/src/sync/root-bound-fs.ranking-v3.test.ts
new file mode 100644
index 0000000..a552718
--- /dev/null
+++ b/packages/core/src/sync/root-bound-fs.ranking-v3.test.ts
@@ -0,0 +1,56 @@
+import test, { type TestContext } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {
+    openTrustedRegularFileInsideRootV1,
+    verifyTrustedPathHierarchyV1,
+} from './root-bound-fs.js';
+
+function symlinkOrSkip(t: TestContext, target: string, link: string): boolean {
+    try {
+        fs.symlinkSync(target, link, 'dir');
+        return true;
+    } catch (error) {
+        const code = (error as NodeJS.ErrnoException).code;
+        if (code === 'EPERM' || code === 'EACCES' || code === 'ENOTSUP') {
+            t.skip(`symlinks unavailable: ${code}`);
+            return false;
+        }
+        throw error;
+    }
+}
+
+test('trusted_hierarchy_rejects_symlink_writable_or_replaced_components', async (t) => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'satori-ranking-trust-'));
+    const outside = fs.mkdtempSync(path.join(os.tmpdir(), 'satori-ranking-outside-'));
+    try {
+        const dir = path.join(root, 'policies');
+        const file = path.join(dir, 'ranking.json');
+        fs.mkdirSync(dir, { mode: 0o700 });
+        fs.writeFileSync(file, '{}\n', { mode: 0o600 });
+        const opened = await openTrustedRegularFileInsideRootV1(file, root);
+        await verifyTrustedPathHierarchyV1(opened);
+
+        fs.chmodSync(dir, 0o777);
+        await assert.rejects(() => openTrustedRegularFileInsideRootV1(file, root), /writable component/i);
+        fs.chmodSync(dir, 0o700);
+
+        const oldDir = path.join(root, 'policies-old');
+        fs.renameSync(dir, oldDir);
+        fs.mkdirSync(dir, { mode: 0o700 });
+        fs.writeFileSync(file, '{}\n', { mode: 0o600 });
+        await assert.rejects(() => verifyTrustedPathHierarchyV1(opened), /replaced or weakened/i);
+        await opened.handle.close();
+
+        fs.rmSync(dir, { recursive: true, force: true });
+        fs.writeFileSync(path.join(outside, 'ranking.json'), '{}\n');
+        if (symlinkOrSkip(t, outside, dir)) {
+            await assert.rejects(() => openTrustedRegularFileInsideRootV1(file, root), /symbolic-link|escapes|rejects/i);
+        }
+    } finally {
+        fs.rmSync(root, { recursive: true, force: true });
+        fs.rmSync(outside, { recursive: true, force: true });
+    }
+});
diff --git a/packages/core/src/sync/root-bound-fs.ts b/packages/core/src/sync/root-bound-fs.ts
index bf22ab9..c155bd8 100644
--- a/packages/core/src/sync/root-bound-fs.ts
+++ b/packages/core/src/sync/root-bound-fs.ts
@@ -503,3 +503,105 @@ export async function openDirectoryInsideRoot(
         descriptorPath: descriptorLink(opened.handle),
     };
 }
+
+export interface TrustedPathComponentV1 {
+    absolutePath: string;
+    device: bigint;
+    inode: bigint;
+    mode: number;
+    kind: 'directory' | 'file';
+}
+
+export interface OpenedTrustedRegularFileV1 extends OpenedRootBoundRegularFile {
+    hierarchy: readonly TrustedPathComponentV1[];
+}
+
+function isUntrustedWritableMode(mode: number): boolean {
+    return (mode & 0o022) !== 0;
+}
+
+async function observeTrustedHierarchy(
+    filePath: string,
+    rootDir: string,
+): Promise<TrustedPathComponentV1[]> {
+    const root = trimTrailingSeparators(path.normalize(await fsp.realpath(rootDir)));
+    const candidate = path.normalize(path.resolve(filePath));
+    if (!isRealPathInsideRoot(candidate, root) || candidate === root) {
+        throw new RootBoundFileError('root_binding_invalid', 'Trusted file must be a descendant of the configured root.');
+    }
+    const relative = path.relative(root, candidate);
+    const segments = relative.split(path.sep).filter(Boolean);
+    const observations: TrustedPathComponentV1[] = [];
+    let current = root;
+    const rootStat = await fsp.lstat(root);
+    if (rootStat.isSymbolicLink() || !rootStat.isDirectory()) {
+        throw new RootBoundFileError('root_binding_invalid', 'Trusted root must be a real directory.');
+    }
+    if (isUntrustedWritableMode(rootStat.mode)) {
+        throw new RootBoundFileError('root_binding_invalid', `Trusted hierarchy contains a group/world-writable component: ${root}`);
+    }
+    observations.push({ absolutePath: root, device: BigInt(rootStat.dev), inode: BigInt(rootStat.ino), mode: rootStat.mode, kind: 'directory' });
+
+    for (let index = 0; index < segments.length; index += 1) {
+        current = path.join(current, segments[index]);
+        const stat = await fsp.lstat(current);
+        const final = index === segments.length - 1;
+        if (stat.isSymbolicLink() || (final ? !stat.isFile() : !stat.isDirectory())) {
+            throw new RootBoundFileError('root_binding_invalid', `Trusted hierarchy rejects symbolic-link or wrong-kind component: ${current}`);
+        }
+        if (isUntrustedWritableMode(stat.mode)) {
+            throw new RootBoundFileError('root_binding_invalid', `Trusted hierarchy contains a group/world-writable component: ${current}`);
+        }
+        observations.push({
+            absolutePath: current,
+            device: BigInt(stat.dev),
+            inode: BigInt(stat.ino),
+            mode: stat.mode,
+            kind: final ? 'file' : 'directory',
+        });
+    }
+    return observations;
+}
+
+export async function verifyTrustedPathHierarchyV1(
+    opened: Pick<OpenedTrustedRegularFileV1, 'handle' | 'observedStat' | 'hierarchy'>,
+): Promise<void> {
+    await verifyStableFileDescriptorObservation(
+        opened.handle,
+        opened.hierarchy[opened.hierarchy.length - 1]?.absolutePath ?? '<unknown>',
+        opened.observedStat,
+    );
+    for (const expected of opened.hierarchy) {
+        const current = await fsp.lstat(expected.absolutePath).catch(() => null);
+        if (
+            !current
+            || current.isSymbolicLink()
+            || BigInt(current.dev) !== expected.device
+            || BigInt(current.ino) !== expected.inode
+            || current.mode !== expected.mode
+            || isUntrustedWritableMode(current.mode)
+            || (expected.kind === 'directory' ? !current.isDirectory() : !current.isFile())
+        ) {
+            throw new RootBoundFileError(
+                'path_identity_changed_during_inspection',
+                `Trusted hierarchy component was replaced or weakened: ${expected.absolutePath}`,
+            );
+        }
+    }
+}
+
+export async function openTrustedRegularFileInsideRootV1(
+    filePath: string,
+    rootDir: string,
+): Promise<OpenedTrustedRegularFileV1> {
+    assertDescriptorBoundIndexingSupported();
+    const hierarchy = await observeTrustedHierarchy(filePath, rootDir);
+    const opened = await openRegularFileWithIdentityInsideRoot(filePath, rootDir);
+    try {
+        await verifyTrustedPathHierarchyV1({ ...opened, hierarchy });
+        return { ...opened, hierarchy };
+    } catch (error) {
+        await opened.handle.close().catch(() => undefined);
+        throw error;
+    }
+}
