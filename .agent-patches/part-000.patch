+import assert from 'node:assert/strict';
+import path from 'node:path';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+import { scoreSearchQualityArtifactV3 } from '../../scripts/satori-search-candidate-score.mjs';
+import { runSearchQualityEvaluation } from './search-quality-evaluation.js';
+
+function workspaceRoot(): string {
+    return path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+}
+
+test('graded_stage_and_legacy_metrics_share_one_authority', async () => {
+    const artifact = await runSearchQualityEvaluation(workspaceRoot(), {
+        excludeRepositoryPaths: ['evals/search-quality/ranking-v3-scorer-integration.test.ts'],
+    });
+    const scored = scoreSearchQualityArtifactV3(artifact);
+    assert.deepEqual(scored.legacySummary, artifact.summary);
+    assert.equal(scored.gradedStages.length, artifact.results.length);
+    assert.deepEqual(
+        scored.gradedStages.map((row) => [row.workloadId, row.limit, row.ownerRank]),
+        artifact.results.map((row) => [row.workloadId, row.limit, row.ownerRank]),
+    );
+});
