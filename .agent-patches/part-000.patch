@@ -0,0 +1,28 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createMcpConfig } from './config.js';
+
+const keys = ['SATORI_RANKING_POLICY_MODE','SATORI_RANKING_POLICY_ROOT','SATORI_RANKING_POLICY_PATH','SATORI_RANKING_POLICY_SHA256','SATORI_RANKING_QUALIFICATION_REGISTRY_PATH','SATORI_RANKING_QUALIFICATION_SCOPE_KEY','SATORI_RANKING_SERVICE_CLASS'] as const;
+
+test('ranking_policy_config_defaults_baseline_and_learned_is_fully_bound', () => {
+    const previous = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
+    try {
+        for (const key of keys) delete process.env[key];
+        assert.deepEqual(createMcpConfig().rankingPolicy, { mode: 'baseline' });
+        process.env.SATORI_RANKING_POLICY_MODE = 'learned';
+        assert.throws(() => createMcpConfig(), /SATORI_RANKING_POLICY_ROOT/);
+        Object.assign(process.env, {
+            SATORI_RANKING_POLICY_ROOT: '/tmp/policies', SATORI_RANKING_POLICY_PATH: 'policy.json',
+            SATORI_RANKING_POLICY_SHA256: 'a'.repeat(64), SATORI_RANKING_QUALIFICATION_REGISTRY_PATH: 'registry.json',
+            SATORI_RANKING_QUALIFICATION_SCOPE_KEY: 'b'.repeat(64), SATORI_RANKING_SERVICE_CLASS: 'online',
+        });
+        const parsed = createMcpConfig().rankingPolicy;
+        assert.equal(parsed.mode, 'learned');
+        if (parsed.mode === 'learned') assert.equal(parsed.artifactSha256, 'a'.repeat(64));
+    } finally {
+        for (const key of keys) {
+            const value = previous[key];
+            if (value === undefined) delete process.env[key]; else process.env[key] = value;
+        }
+    }
+});
