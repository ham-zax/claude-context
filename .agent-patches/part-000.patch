+    schemaVersion: 'validated_rerank_response_v1',
+    providerKey: 'p', rerankerIdentity: 'm', rerankerProjectionIdentity: 'proj',
+    providerConfigurationDigest: 'a'.repeat(64), providerRequestContractSha256: 'b'.repeat(64),
+    canonicalRequestSha256: 'c'.repeat(64), requestCandidateIds: ['a','b','c'],
+    results: [
+        { candidateId: 'b', rank: 1, rawScore: 10 },
+        { candidateId: 'a', rank: 2, rawScore: 7 },
+        { candidateId: 'c', rank: 3, rawScore: 1 },
