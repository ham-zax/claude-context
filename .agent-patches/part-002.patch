+    createdFromCommit: 'a'.repeat(40), trainingManifestSha256: sha('b'), trainingCodeSha256: sha('c'), trainingContractSha256: sha('d'),
+    qualificationTargetSha256: sha('e'), residualModelSha256: sha('f'),
+    normalization: { schemaVersion: 'ranking_normalization_contract_v1' as const, featureOrder: ['x'], means: [0], scales: [1], missingValuePolicy: 'indicator_zero_fill' as const },
