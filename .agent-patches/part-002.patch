+++ b/packages/mcp/src/core/ranking-policy-qualification.ts
@@ -181,3 +181,17 @@ export function parseRankingPolicyQualificationRegistryV1(value: unknown): Ranki
     }
     return { schemaVersion: 'ranking_policy_qualification_registry_v1', entries };
 }
+
+export function qualificationRegistryLogicalKeyV1(entry: QualificationEntryKeyV1): string {
+    return logicalKey(entry);
+}
+
+export function canonicalizeRankingPolicyQualificationRegistryV1(value: unknown): string {
+    return `${canonicalJson(parseRankingPolicyQualificationRegistryV1(value))}\n`;
+}
+
+export function canonicalRankingPolicyQualificationRegistrySha256V1(value: unknown): string {
+    return crypto.createHash('sha256')
+        .update(canonicalizeRankingPolicyQualificationRegistryV1(value), 'utf8')
+        .digest('hex');
+}
