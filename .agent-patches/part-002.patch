+import {
+    BASELINE_RANKING_POLICY_IDENTITY,
+    DISABLED_RERANKER_IDENTITY_V1,
+    LEARNED_RANKING_POLICY_IDENTITY,
+} from './ranking-policy-identity.js';
+import type { RankingPolicyV3Artifact } from './ranking-policy-artifact.js';
+import type {
+    QualifiedRerankerV1,
+    QualificationRegistryEntryV1,
+} from './ranking-policy-qualification.js';
+
+export type RankingPolicySelectionV1 =
+    | {
+        mode: 'baseline';
+        policyIdentity: typeof BASELINE_RANKING_POLICY_IDENTITY;
+        artifactSha256: null;
+        rerankerIdentity: 'deterministic_baseline';
+        rerankerProjectionIdentity: 'not_applicable';
+    }
+    | {
+        mode: 'disabled';
+        policyIdentity: typeof LEARNED_RANKING_POLICY_IDENTITY;
+        artifactSha256: string;
+        rerankerIdentity: typeof DISABLED_RERANKER_IDENTITY_V1;
+        rerankerProjectionIdentity: 'not_applicable';
+        artifact: RankingPolicyV3Artifact;
+    }
+    | {
+        mode: 'provider_derived';
+        policyIdentity: typeof LEARNED_RANKING_POLICY_IDENTITY;
+        artifactSha256: string;
+        rerankerIdentity: string;
+        rerankerProjectionIdentity: string;
+        configuredReranker: QualifiedRerankerV1;
+        artifact: RankingPolicyV3Artifact;
+    };
+
+function sameReranker(left: QualifiedRerankerV1, right: QualifiedRerankerV1): boolean {
+    return left.providerKey === right.providerKey
+        && left.rerankerIdentity === right.rerankerIdentity
+        && left.rerankerProjectionIdentity === right.rerankerProjectionIdentity
+        && left.providerConfigurationDigest === right.providerConfigurationDigest
+        && left.providerRequestContractSha256 === right.providerRequestContractSha256;
+}
+
+export function selectRankingPolicyV1(input: {
+    requestedMode: 'baseline' | 'learned';
+    artifactSha256?: string;
+    artifact?: RankingPolicyV3Artifact;
+    activationEntry?: Extract<QualificationRegistryEntryV1, { status: 'activation_qualified' }>;
+    configuredReranker?: QualifiedRerankerV1;
+}): RankingPolicySelectionV1 {
+    if (input.requestedMode === 'baseline') {
+        return {
+            mode: 'baseline', policyIdentity: BASELINE_RANKING_POLICY_IDENTITY, artifactSha256: null,
+            rerankerIdentity: 'deterministic_baseline', rerankerProjectionIdentity: 'not_applicable',
+        };
+    }
+    const artifact = input.artifact;
+    const entry = input.activationEntry;
+    const artifactSha256 = input.artifactSha256;
+    if (!artifact || !entry || !artifactSha256 || entry.artifactSha256 !== artifactSha256) {
+        throw new Error('Learned ranking requires one exact activation-qualified artifact entry.');
+    }
+    if (entry.selectedArtifactMode !== artifact.neuralReorderPolicy.mode) {
+        throw new Error('Activation entry mode does not match the artifact mode.');
+    }
+    if (artifact.neuralReorderPolicy.mode === 'disabled') {
