+            mode: 'disabled', policyIdentity: LEARNED_RANKING_POLICY_IDENTITY, artifactSha256,
+            rerankerIdentity: DISABLED_RERANKER_IDENTITY_V1, rerankerProjectionIdentity: 'not_applicable', artifact,
+        };
+    }
+    const configured = input.configuredReranker;
+    const qualified = entry.qualifiedRerankers[0];
+    const applicability = artifact.applicability;
